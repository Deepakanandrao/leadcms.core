{
  "MigrateOnStart": false,
  "Postgres": {
    "Port": "15432",
    "Database": "LeadCMS-test"
  },
  "Elastic": {
    "Enable": false,
    "Port": "19200",
    "IndexPrefix": "LeadCMS-test"
  },
  "ApiSettings": {
    "MaxListSize": 100
  },
  "Tasks": {
    "SyncEsTask": {
      "Enable": false
    },
    "DomainVerificationTask": {
      "BatchInterval": 0
    }
  },
  "Jwt": {
    "Secret": "12345678901234567890123456789012",
    "Issuer": "issuer",
    "Audience": "audience"
  },
  "Identity": {
    "LockoutTime": "0.5",
    "MaxFailedAccessAttempts": "5"
  },
  "SupportedLanguages": [
    "en",
    "en-US",
    "fr-FR",
    "de-DE",
    "es-ES",
    "it-IT",
    "ja-JP",
    "zh-CN",
    "zh-Hans-CN",
    "ru-RU",
    "pt-BR",
    "nl-NL",
    "ar-SA",
    "sv-SE"
  ]
}