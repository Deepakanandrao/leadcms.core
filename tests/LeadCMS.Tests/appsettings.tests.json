{
  "MigrateOnStart": false,
  "Postgres": {
    "Port": "15432",
    "Database": "LeadCMS-test"
  },
  "Elastic": {
    "Enable": true,
    "Port": "19200",
    "IndexPrefix": "LeadCMS-test"
  },
  "ApiSettings": {
    "MaxListSize": 10
  },
  "Tasks": {
    "SyncEsTask": {
      "Enable": false
    },
    "DomainVerificationTask": {
      "BatchInterval": 0
    }
  },
  "Jwt": {
    "Secret": "12345678901234567890123456789012",
    "Issuer": "issuer",
    "Audience": "audience"
  },
  "Identity": {
    "LockoutTime": "0.1",
    "MaxFailedAccessAttempts": "2"
  },
  "SupportedLanguages": [
    "en",
    "fr",
    "de",
    "es",
    "it",
    "ja",
    "zh",
    "ru",
    "pt",
    "nl",
    "ar",
    "sv"
  ]
}